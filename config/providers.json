        "minimax-m2.7": {"name": "MiniMax-M2.7", "description": "MiniMax M2.7"},
        "minimax-m2.5": {"name": "MiniMax-M2.5", "description": "MiniMax M2.5"}
      }
    },
    "glm": {
      "name": "GLM-5 (Z.AI)",
